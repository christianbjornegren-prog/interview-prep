rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function getRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
    }
    function isAdmin() { return getRole() == 'admin' }
    function isSaljare() { return getRole() == 'saljare' }
    function isOwner(uid) { return request.auth.uid == uid }

    match /users/{uid} {
      allow read: if request.auth != null &&
        (isOwner(uid) || isAdmin() || isSaljare())
      allow write: if request.auth != null &&
        (isOwner(uid) || isAdmin())
    }

    match /users/{uid}/competencies/{docId} {
      allow read: if request.auth != null &&
        (isOwner(uid) || isAdmin() || isSaljare())
      allow write: if request.auth != null &&
        (isOwner(uid) || isAdmin() || isSaljare())
    }

    match /users/{uid}/jobs/{jobId} {
      allow read: if request.auth != null &&
        (isOwner(uid) || isAdmin() || isSaljare())
      allow write: if request.auth != null &&
        (isOwner(uid) || isAdmin() || isSaljare())
    }

    // Feedback is consent-gated. The konsult (owner) sees everything; a
    // säljare/admin may read a session ONLY when the owner has opted in via
    // sharedWithSeller == true. Owner toggles sharing through update.
    match /users/{uid}/jobs/{jobId}/feedback/{feedbackId} {
      allow read: if request.auth != null && (
        isOwner(uid) ||
        ((isSaljare() || isAdmin()) && resource.data.sharedWithSeller == true)
      )
      allow create: if request.auth != null && isOwner(uid)
      allow update: if request.auth != null && isOwner(uid)
      allow delete: if request.auth != null && (isOwner(uid) || isAdmin())
    }

    // NOTE: the old recursive `/{path=**}/feedback` rule (admin reads ALL
    // feedback) has been removed. The driftöversikt no longer reads feedback,
    // and a säljare reads shared sessions per-job via the consent-gated rule
    // above (queries always filter .where('sharedWithSeller','==',true)).

    // Technical operations log. Write-only for any signed-in user (own uid
    // only); admins read for the driftöversikt. Immutable once written.
    match /systemEvents/{eventId} {
      allow create: if request.auth != null &&
        request.resource.data.uid == request.auth.uid
      allow read: if request.auth != null && isAdmin()
      allow update, delete: if false
    }

    match /pendingProfiles/{email} {
      allow read, write: if request.auth != null &&
        (isAdmin() || isSaljare())
      // A konsult must be able to read + delete THEIR OWN pending profile
      // (doc id == their email) during first-login migration in AuthGate.
      // Without this the säljare-prepared competencies/jobs are never copied
      // over and the konsult lands on an empty account. Self-cleanup only:
      // no create/update, so a konsult can never seed or alter pending data.
      allow get, delete: if request.auth != null &&
        request.auth.token.email != null &&
        request.auth.token.email.lower() == email.lower()
    }
  }
}
